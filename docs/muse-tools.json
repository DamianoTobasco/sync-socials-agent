    {
      "name": "syncsocials_create_content_draft",
      "title": "Create Untargeted Content Draft",
      "description": "Save a generated marketing concept as an untargeted Sync Socials draft. Use this for caption and campaign ideas that do not have media or destination accounts selected yet. This never schedules or publishes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "Internal campaign title. Include the intended platform when useful, for example 'Instagram · Stop posting manually'."
          },
          "body": {
            "description": "Ready-to-use caption or post copy.",
            "type": "string",
            "maxLength": 20000
          },
          "tags": {
            "description": "Optional hashtags without #. An empty array saves no tags; omission derives tags from the title.",
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Create Untargeted Content Draft",
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": [
              "openid",
              "email"
            ]
          }
        ]
      }
    },
    {
      "name": "syncsocials_create_post",
      "title": "Create Post",
      "description": "Create a draft, schedule a post, or publish now to selected connected TikTok, YouTube, LinkedIn personal, Telegram, Discord, Slack, Facebook, or Instagram accounts. Schedule or publish only when the user explicitly requests it, with approved content, destinations and required privacy/disclosure choices. Omit action to save a draft.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "description": "Internal post title only. If the user says 'name it' or 'title it', put that text here.",
            "type": "string"
          },
          "body": {
            "description": "Caption or description only. Leave empty unless the user explicitly provides caption/body text.",
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "video"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "draft",
              "schedule",
              "publish"
            ]
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "facebook",
                "instagram",
                "youtube",
                "tiktok",
                "linkedin",
                "telegram",
                "discord",
                "slack"
              ]
            }
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "platform": {
                  "type": "string",
                  "enum": [
                    "facebook",
                    "instagram",
                    "youtube",
                    "tiktok",
                    "linkedin",
                    "telegram",
                    "discord",
                    "slack"
                  ]
                },
                "accountId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "platform",
                "accountId"
              ]
            }
          },
          "mediaAssetIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "imagePrompt": {
            "description": "For type=image posts with no media: a vivid, production-ready prompt for the photo to generate (subject, setting, lighting, style, colors). When the server has image generation configured, Sync Socials generates a portrait image from this prompt and attaches it automatically — you do not need to upload media separately.",
            "type": "string"
          },
          "videoPrompt": {
            "description": "For type=video posts with no media: a shot-by-shot prompt for the short-form vertical video to generate. When the server has video generation configured, Sync Socials renders the video and attaches it automatically. Rendering is asynchronous and may take 1-3 minutes.",
            "type": "string"
          },
          "startImageUrl": {
            "description": "Optional for type=video: a public image URL or data URI to animate FROM (image-to-video). Use the creator's own footage frame, a product/app screenshot, or a reference still so the video is built on their visual instead of generated from scratch.",
            "type": "string"
          },
          "tags": {
            "description": "Optional hashtags without #. If omitted, Sync Socials will auto-generate three relevant hashtags from the title. An empty array saves no tags.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scheduledFor": {
            "type": "string"
          },
          "youtubePrivacyStatus": {
            "type": "string",
            "enum": [
              "private",
              "unlisted",
              "public"
            ]
          },
          "tiktokPrivacyLevel": {
            "type": "string",
            "enum": [
              "PUBLIC_TO_EVERYONE",
              "MUTUAL_FOLLOW_FRIENDS",
              "FOLLOWER_OF_CREATOR",
              "SELF_ONLY",
              "PRIVATE_TO_SELF"
            ]
          },
          "tiktokAllowComment": {
            "type": "boolean"
          },
          "tiktokAllowDuet": {
            "type": "boolean"
          },
          "tiktokAllowStitch": {
            "type": "boolean"
          },
          "tiktokCommercialContentEnabled": {
            "type": "boolean"
          },
          "tiktokBrandOrganic": {
            "type": "boolean"
          },
          "tiktokBrandedContent": {
            "type": "boolean"
          },
          "tiktokMusicUsageConfirmed": {
            "type": "boolean"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Create Post",
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": [
              "openid",
              "email"
            ]
          }
        ]
      }
    },
