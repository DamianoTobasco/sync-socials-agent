    {
      "name": "syncsocials_generate_viral_concepts",
      "title": "Generate Viral Machine Content Concepts",
      "description": "Generate brand-specific social content concepts using Viral Machine formats such as reaction hooks, story stacks, POV, and listicles. Provide a website or business brief to analyze and save a brand profile when needed. Returns hooks, captions and concepts for review; does not render or publish. Requires an AI provider already configured in the workspace and uses its allowance. Use this when the user wants concepts tailored to their saved business or wants to save or produce them in Sync Socials. Engagement results are not guaranteed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "angle": {
            "description": "Optional focus for this batch, e.g. 'summer promo' or 'feature launch'",
            "type": "string",
            "maxLength": 1000
          },
          "formats": {
            "description": "Optional template ids to restrict to. Available: green-screen, when-relatable, wall-of-text, pov, me-after, reaction-hook, listicle, hot-take",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "website": {
            "type": "string",
            "maxLength": 2000
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "brand": {
            "description": "Which business to generate for, by name or id (workspaces can hold several — e.g. 'Evolve' vs 'Sync Socials'). Omit for the first/only one.",
            "type": "string",
            "maxLength": 60
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "title": "Generate Viral Machine Content Concepts",
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": [
              "openid",
              "email"
            ]
          }
        ]
      }
    },
    {
      "name": "syncsocials_produce_viral_video",
      "title": "Produce Viral Machine Video",
      "description": "Edit one user-approved concept into a vertical video by assembling existing library clips or the user's uploaded brand footage, overlaying text, and mixing an existing music track. This tool does not generate images, video footage, speech, or music through AI models. Save it as a draft for review, or schedule only on explicit request with selected destination account IDs. Uses workspace production allowances. If final media processing is pending, returns the post ID with processing=true; use get_post to check completion and obtain a watch/download URL. TikTok video assembly saves drafts; use the post tools with the user's privacy and disclosure choices to schedule or publish afterward.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "concept": {
            "type": "object",
            "properties": {
              "hook": {
                "type": "string",
                "maxLength": 300
              },
              "caption": {
                "type": "string",
                "maxLength": 5000
              },
              "hashtags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cta": {
                "type": "string",
                "maxLength": 200
              },
              "format": {
                "type": "string",
                "maxLength": 120
              },
              "templateId": {
                "type": "string",
                "maxLength": 60
              },
              "overlayText": {
                "type": "string",
                "maxLength": 1200
              },
              "textBeats": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sceneryVibe": {
                "type": "string",
                "maxLength": 40
              },
              "musicMood": {
                "type": "string",
                "maxLength": 20
              },
              "memeQuery": {
                "type": "string",
                "maxLength": 120
              },
              "reactionEmotion": {
                "type": "string",
                "maxLength": 40
              },
              "reactionGender": {
                "type": "string",
                "maxLength": 20
              },
              "whyItWorks": {
                "type": "string",
                "maxLength": 500
              }
            },
            "description": "The concept object, passed through unchanged"
          },
          "accountIds": {
            "description": "Selected destination account IDs from list_connections. Required when scheduling. Account-linked assistant drafts have no destinations unless IDs are provided.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "videoMethod": {
            "description": "library (default): licensed reaction/scenery clips. remix: opens with a hook clip then cuts to the user's own brand footage from their bucket.",
            "type": "string",
            "enum": [
              "library",
              "remix"
            ]
          },
          "footageCategory": {
            "description": "For remix: which business/category of the footage bucket to pull from (e.g. 'Evolve'). Omit to pull from all footage.",
            "type": "string",
            "maxLength": 40
          },
          "action": {
            "type": "string",
            "enum": [
              "draft",
              "schedule"
            ]
          },
          "scheduledFor": {
            "description": "ISO datetime, required when action=schedule",
            "type": "string"
          },
          "youtubePrivacyStatus": {
            "type": "string",
            "enum": [
              "private",
              "unlisted",
              "public"
            ]
          }
        },
        "required": [
          "concept"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
